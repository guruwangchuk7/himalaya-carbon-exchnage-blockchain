generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique // Supabase Auth User ID
  email          String?  @unique
  walletAddress  String?  @unique
  organization   String
  role           Role     @default(BUYER)
  isAuthorized   Boolean  @default(false)
  kycDocumentUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rfqs           RFQ[]
}

enum Role {
  BUYER
  GOVERNMENT_ADMIN
  TRADER
  OPERATOR
  AUDITOR
}


model RegistryProject {
  id                 String             @id @default(cuid())
  projectId          String             @unique // e.g BHU-RE-2023-001
  projectName        String
  methodology        String
  vintageYear        Int
  status             ProjectState       @default(DRAFT)
  totalVolume        Int
  isArticle6         Boolean            @default(false)
  documentsUrl       Json?
  developerId        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rfqs               RFQ[]
}

enum ProjectState {
  DRAFT
  UNDER_AUDIT
  APPROVED
  ISSUED_ON_CHAIN
}

model RFQ {
  id               String          @id @default(cuid())
  buyerId          String?
  buyer            Profile?        @relation(fields: [buyerId], references: [id])
  buyerName        String?         // For non-logged in or guest institutional RFQs
  projectId        String
  project          RegistryProject? @relation(fields: [projectId], references: [id])
  projectName      String?         // Fallback if registry project not in DB
  targetVolume     Int
  targetPriceCents Int?
  purpose          String?
  status           RFQStatus       @default(OPEN)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Participant {
  id             String   @id @default(cuid())
  address        String   @unique
  name           String
  isAuthorized   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Certificate {
  id             String   @id @default(cuid())
  certificateId  String   @unique // HCR-XXXX
  projectId      String
  projectName    String
  vintageYear    Int
  amount         String
  beneficiary    String
  retirementHash String   @unique
  cadSyncId      String
  issuedAt       DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String   // e.g. "WHITELIST_UPDATE"
  metadata     Json
  actorAddress String?  // Admin or Registry wallet
  actorEmail   String?  // Supabase User email
  eventHash    String   @unique
  timestamp    DateTime @default(now())

  @@index([action])
}

model UserBalance {
  id        String   @id @default(cuid())
  userId    String   // Matches Profile.userId or Supabase userId
  projectSlug String // Matches RegistryProject.projectId (e.g. BT-FOR-2024-001)
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, projectSlug])
}

enum RFQStatus {
  OPEN
  NEGOTIATING
  MATCHED
  SETTLED_ON_CHAIN
  CANCELLED
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String?  // Supabase User ID (optional for Guest/Institutional checkouts)
  amount                Int      // in cents
  currency              String   @default("usd")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String   @unique
  stripePaymentIntentId String?  @unique
  customerEmail         String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([stripeSessionId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}
